# Rust build artefacts
/target/

# The UI's build and its dependencies. `web/dist` is what `npm run build`
# writes and what the binary embeds when it is there; without it the binary
# serves `placeholder.html` instead (phase 3's D7).
/crates/distlib-ui/web/dist/
/crates/distlib-ui/web/node_modules/
# Playwright's traces and screenshots of failed end-to-end tests.
/crates/distlib-ui/web/test-results/

# Secrets — never committed (see CLAUDE.md § Security)
.env
.env.*
!.env.example

# Local node data directories (keys, redb, SQLite, tantivy, blobs)
/data/
*.distlib-data/

# Logs
*.log

# Editor / OS noise
.DS_Store
*.swp
.vscode/
